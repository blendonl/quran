# Local model cache directory (optional)
# QURAN_MODELS_DIR=./models

# Phoneme engine: espeak | nrshoudi | muaalem
# QURAN_PHONEME_ENGINE_TYPE=espeak

# CTC text engine: nemo | wav2vec2 | whisper | tarteel
# QURAN_CTC_ENGINE_TYPE=nemo
# QURAN_CTC_MODEL=jonatasgrosman/wav2vec2-large-xlsr-53-arabic
# QURAN_CTC_DEVICE=auto
# QURAN_CTC_TORCH_DTYPE=float32
# QURAN_CTC_CONFIDENCE_THRESHOLD=0.3
# QURAN_CTC_DECODE_MODE=beam  # requires pip install -e ".[beam]"
# QURAN_CTC_BEAM_WIDTH=10

# Whisper (requires pip install -e ".[whisper]")
# QURAN_WHISPER_MODEL=openai/whisper-large-v3-turbo
# QURAN_WHISPER_DEVICE=auto
# QURAN_WHISPER_COMPUTE_TYPE=float16
# QURAN_WHISPER_BEAM_SIZE=5
# QURAN_WHISPER_CONFIDENCE_THRESHOLD=0.3

# Tarteel (Quran-fine-tuned Whisper, requires pip install -e ".[whisper]")
# QURAN_TARTEEL_MODEL=tarteel-ai/whisper-base-ar-quran

# Quran phoneme model
# QURAN_QURAN_PHONEME_MODEL=TBOGamer22/wav2vec2-quran-phonetics

# Phoneme engine models
# QURAN_PHONEME_MODEL=facebook/wav2vec2-xlsr-53-espeak-cv-ft
# QURAN_NRSHOUDI_MODEL=nrshoudi/wav2vec2-large-xls-r-300m-Arabic-phonemeIPA
# QURAN_MUAALEM_MODEL=obadx/muaalem-model-v3_2
# QURAN_PHONEME_CONFIDENCE_THRESHOLD=0.25

# Noise reduction (requires pip install -e ".[deepfilter]")
# QURAN_NOISE_REDUCTION_ENABLED=true
# QURAN_NOISE_REDUCTION_AGC=true
# QURAN_NOISE_REDUCTION_AGC_TARGET_RMS=0.1
# QURAN_NOISE_REDUCTION_AGC_MAX_GAIN=20.0

# Qiraah style
# QURAN_QIRAAH=hafs

# Audio
# QURAN_AUDIO_MAX_BUFFER_S=3.0
# QURAN_AUDIO_EMIT_INTERVAL_S=0.25
# QURAN_AUDIO_SAMPLE_RATE=16000
# QURAN_AUDIO_ENERGY_THRESHOLD=0.005

# VAD
# QURAN_VAD_AGGRESSIVENESS=2
# QURAN_MIN_SPEECH_FRAMES=3

# Data paths
# QURAN_QURAN_DATA_PATH=app/quran/data/quran_uthmani.json
# QURAN_IPA_DATA_PATH=app/quran/data/ipa_hafs.json
